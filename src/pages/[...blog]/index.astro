---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import merge from 'lodash.merge';
import type { ImageMetadata } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import SinglePost from '~/components/blog/SinglePost.astro';
import ToBlogLink from '~/components/blog/ToBlogLink.astro';

import { getCanonical, getPermalink } from '~/utils/permalinks';
import { getStaticPathsBlogPost, blogPostRobots } from '~/utils/blog';
import { findImage } from '~/utils/images';
import type { MetaData } from '~/types';
import RelatedPosts from '~/components/blog/RelatedPosts.astro';

export const prerender = true;

export const getStaticPaths = (async () => {
  return await getStaticPathsBlogPost();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props as Props;

const url = getCanonical(getPermalink(post.permalink, 'post'));
const image = (await findImage(post.image)) as ImageMetadata | string | undefined;

// JSON-LD Article schema para cada post del blog
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  url: String(url),
  datePublished: post.publishDate ? post.publishDate.toISOString() : undefined,
  dateModified: post.updateDate ? post.updateDate.toISOString() : post.publishDate?.toISOString(),
  author: {
    '@type': 'Organization',
    '@id': 'https://tachetech.com/#organization',
    name: post.author ?? 'Tache Technology',
  },
  publisher: { '@id': 'https://tachetech.com/#organization' },
  isPartOf: { '@id': 'https://tachetech.com/#website' },
  inLanguage: 'es-CO',
  ...(image ? { image: { '@type': 'ImageObject', url: String(image) } } : {}),
  ...(post.category ? { articleSection: post.category } : {}),
  ...(post.tags?.length ? { keywords: post.tags.join(', ') } : {}),
};

const metadata = merge(
  {
    title: post.title,
    description: post.excerpt,
    robots: {
      index: blogPostRobots?.index,
      follow: blogPostRobots?.follow,
    },
    openGraph: {
      type: 'article',
      ...(image ? { images: [{ url: image, width: (image as ImageMetadata)?.width, height: (image as ImageMetadata)?.height }] } : {}),
    },
  },
  { ...(post?.metadata ? { ...post.metadata, canonical: post.metadata?.canonical || url } : {}) }
) as MetaData;
---

<Layout metadata={metadata} schemas={[articleSchema]}>
  <SinglePost post={{ ...post, image: image }} url={url} />
  <ToBlogLink />
  <RelatedPosts post={post} />
</Layout>
