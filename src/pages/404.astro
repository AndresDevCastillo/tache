---
import PageLayout from '~/layouts/PageLayout.astro';
import { getHomePermalink } from '~/utils/permalinks';
import { Icon } from 'astro-icon/components';
import { WHATSAPP_URL } from '~/navigation';

const metadata = {
  title: 'Página no encontrada | Tache Technology',
  robots: { index: false, follow: false },
};
---

<PageLayout metadata={metadata}>
  <section class="section flex items-center min-h-[72vh]" aria-labelledby="heading-404">
    <div class="container-pro mx-auto text-center max-w-xl">
      <!-- Icono decorativo -->
      <div
        class="mx-auto inline-flex h-20 w-20 items-center justify-center rounded-2xl bg-[#eef0ff]"
        aria-hidden="true"
      >
        <Icon name="tabler:file-unknown" class="h-10 w-10 text-[#1d0cdf]" />
      </div>

      <!-- Número 404 -->
      <p class="mt-6 text-8xl font-extrabold leading-none text-[#1d0cdf]" aria-hidden="true">404</p>

      <!-- Título -->
      <h1 id="heading-404" class="mt-4 text-2xl font-bold text-slate-900 md:text-3xl">
        Página no encontrada
      </h1>

      <!-- Descripción -->
      <p class="mt-4 text-lg leading-relaxed text-slate-600">
        La página que buscas no existe o fue movida. Puedes volver al inicio o escribirnos
        directamente por WhatsApp y te ayudamos.
      </p>

      <!-- CTAs -->
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={getHomePermalink()} class="btn-primary w-full sm:w-auto">
          <Icon name="tabler:home" class="h-5 w-5" />
          Volver al inicio
        </a>
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary w-full sm:w-auto"
        >
          <Icon name="tabler:brand-whatsapp" class="h-5 w-5 text-emerald-600" />
          Escribir por WhatsApp
        </a>
      </div>

      <!-- Microcopy de confianza -->
      <p class="mt-8 inline-flex items-center gap-1.5 text-sm text-slate-500">
        <Icon name="tabler:clock-hour-4" class="h-4 w-4 text-[#1d0cdf]" />
        Respondemos en menos de 24 horas hábiles
      </p>
    </div>
  </section>
</PageLayout>
