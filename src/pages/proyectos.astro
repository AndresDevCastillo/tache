---
import Layout from '~/layouts/PageLayout.astro';
import HeroPremium from '~/components/widgets/HeroPremium.astro';
import ProjectsGrid from '~/components/widgets/ProjectsGrid.astro';
import CtaBanner from '~/components/widgets/CtaBanner.astro';

const metadata = {
  title: 'Soluciones que construimos | Tache Technology Montería',
  description:
    'Tipos de soluciones digitales que desarrollamos: software a medida, páginas web, automatización, bots con IA e integraciones para empresas en Montería y Colombia.',
};

const projects = [
  {
    category: 'Logística',
    title: 'Control operativo de entregas',
    problem: 'Empresas con procesos manuales y poco seguimiento de entregas generan retrasos y errores.',
    solution: 'Desarrollamos plataformas web para organizar rutas, gestionar estados y centralizar el control operativo.',
    result: 'Mayor visibilidad del proceso, menos tareas manuales y seguimiento en tiempo real.',
    icon: 'tabler:truck-delivery',
    accent: 'blue' as const,
    href: '/contacto',
    ctaText: 'Quiero algo así',
  },
  {
    category: 'Inventario',
    title: 'Sistema de inventario digital',
    problem: 'Negocios que manejan stock con hojas de cálculo pierden trazabilidad y cometen errores.',
    solution: 'Creamos sistemas web para registrar productos, movimientos, alertas y reportes automáticos.',
    result: 'Información centralizada, mejor control de stock y decisiones basadas en datos.',
    icon: 'tabler:box-seam',
    accent: 'indigo' as const,
    href: '/contacto',
    ctaText: 'Quiero algo así',
  },
  {
    category: 'Salud',
    title: 'Plataforma de citas y pacientes',
    problem: 'Centros de salud que gestionan citas y pacientes de forma manual pierden tiempo y calidad de atención.',
    solution: 'Desarrollamos plataformas de agendamiento, gestión de pacientes y consultas en línea.',
    result: 'Mejor organización, atención más ágil y disponibilidad para los usuarios.',
    icon: 'tabler:stethoscope',
    accent: 'cyan' as const,
    href: '/contacto',
    ctaText: 'Quiero algo así',
  },
  {
    category: 'Comercio',
    title: 'Tienda online con catálogo y pagos',
    problem: 'Comercios que venden solo por WhatsApp tienen pedidos dispersos y proceso lento.',
    solution: 'Construimos tiendas en línea con catálogo, carrito y métodos de pago integrados.',
    result: 'Proceso de venta más ordenado, mayor alcance y menos carga operativa.',
    icon: 'tabler:building-store',
    accent: 'emerald' as const,
    href: '/contacto',
    ctaText: 'Quiero algo así',
  },
  {
    category: 'Automatización',
    title: 'Asistente virtual y bot de atención',
    problem: 'Equipos pequeños no alcanzan a responder consultas fuera de horario laboral.',
    solution: 'Desarrollamos bots inteligentes para web y WhatsApp que responden, filtran y derivan casos.',
    result: 'Atención disponible 24/7, respuestas inmediatas y equipo enfocado en lo que importa.',
    icon: 'tabler:message-chatbot',
    accent: 'amber' as const,
    href: '/contacto',
    ctaText: 'Quiero algo así',
  },
  {
    category: 'Inmobiliaria',
    title: 'Catálogo digital con búsqueda y filtros',
    problem: 'Empresas sin presencia digital pierden leads calificados frente a competidores con sitio web.',
    solution: 'Creamos sitios con catálogo dinámico, filtros de búsqueda y panel de administración sin código.',
    result: 'Mayor visibilidad, captación de leads calificados y marca más fuerte en el mercado.',
    icon: 'tabler:home',
    accent: 'rose' as const,
    href: '/contacto',
    ctaText: 'Quiero algo así',
  },
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Soluciones que construimos — Tache Technology',
    url: 'https://tachetech.com/proyectos',
    description:
      'Tipos de soluciones digitales que desarrolla Tache Technology: software a medida, automatización, bots con IA e integraciones para empresas en Montería y Colombia.',
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: projects.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'CreativeWork',
          name: p.title,
          about: p.category,
          description: `${p.problem} ${p.solution} ${p.result}`,
        },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://tachetech.com/' },
      { '@type': 'ListItem', position: 2, name: 'Soluciones', item: 'https://tachetech.com/proyectos' },
    ],
  },
];
---

<Layout metadata={metadata} schemas={schemas}>
  <HeroPremium
    eyebrow="Lo que construimos"
    title='Soluciones digitales que <span class="text-[#1d0cdf]">resuelven problemas reales</span>'
    subtitle="Estos son los tipos de proyectos que desarrollamos. Si tu negocio enfrenta un reto similar, podemos construir algo a tu medida."
    showCtas={false}
  />

  <ProjectsGrid
    items={projects}
    eyebrow="Tipos de soluciones"
    title="¿Qué podemos construir para ti?"
    subtitle="Ejemplos de soluciones que desarrollamos para empresas con retos similares a los tuyos."
    variant="cases"
    showCta={false}
  />

  <CtaBanner
    title="¿Tu negocio tiene un reto similar?"
    subtitle="Cuéntanos qué necesitas y en 30 minutos te orientamos sobre la mejor solución para tu caso."
    primaryText="Hablar de mi proyecto"
  />
</Layout>
